{
  "name": "udm-pathfinder-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "node src/local-server.js",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create udm_pathfinder",
    "db:migrate": "wrangler d1 execute udm_pathfinder --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute udm_pathfinder --remote --file=./schema.sql",
    "db:seed": "wrangler d1 execute udm_pathfinder --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute udm_pathfinder --remote --file=./seed.sql"
  },
  "devDependencies": {
    "wrangler": "^4.144.0"
  }
}
